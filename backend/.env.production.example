# =============================================================
# Print3D Platform — Production environment (Railway)
# Copie para o painel do Railway (Variables). NUNCA commitar valores reais.
# Gere segredos com: python -c "import secrets; print(secrets.token_hex(32))"
# =============================================================

APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=GERAR_COM_secrets_token_hex_32
JWT_SECRET_KEY=GERAR_COM_secrets_token_hex_32

# Banco e Redis do Railway. IMPORTANTE: a DATABASE_URL precisa do driver
# asyncpg, então troque "postgresql://" por "postgresql+asyncpg://".
DATABASE_URL=postgresql+asyncpg://USER:PASS@HOST:PORT/DB
REDIS_URL=redis://default:PASS@HOST:PORT
CELERY_BROKER_URL=redis://default:PASS@HOST:PORT
CELERY_RESULT_BACKEND=redis://default:PASS@HOST:PORT/1

# IA — deixe vazio enquanto AI_MOCK_MODE=true
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
RUNPOD_API_KEY=
RUNPOD_TRELLIS_ENDPOINT_ID=

# Mantenha tudo em mock até validar o deploy; só então ligue as APIs reais.
AI_MOCK_MODE=true
RUNPOD_MOCK_MODE=true
STORAGE_MOCK_MODE=true

# Storage real (Cloudflare R2/S3) — preencher ao sair do mock.
STORAGE_PROVIDER=r2
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=print3d-assets
STORAGE_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_PUBLIC_URL=https://assets.SEU_DOMINIO.com
STATIC_BASE_URL=https://SEU_BACKEND.up.railway.app/static

# CORS — URL EXATA do Vercel (com https, sem barra no final).
ALLOWED_ORIGINS=https://3d-factory.vercel.app,http://localhost:3001

ADMIN_EMAIL=admin@print3d.com
ADMIN_PASSWORD=SENHA_FORTE_AQUI
ADMIN_NAME=Admin

SENTRY_DSN=
